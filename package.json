    "react-ga4": "^2.1.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@portabletext/types": "^2.0.15",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/oxide": "^4.3.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
